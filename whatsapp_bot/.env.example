WHATSAPP_VERIFY_TOKEN=change-me
WHATSAPP_ACCESS_TOKEN=replace-with-meta-token
WHATSAPP_PHONE_NUMBER_ID=123456789012345

# Optional comma-separated list for daily broadcast endpoint
WHATSAPP_ADMIN_NUMBERS=2348000000000,2348111111111

# Optional: set secret if you plan to enforce signature checks
WHATSAPP_WEBHOOK_SECRET=

# Daily schedule target hour in UTC (for external cron to trigger /broadcast/daily)
DAILY_POST_HOUR_UTC=7

# SQLite database file path
BOT_DB_PATH=study_bot.db

PORT=8000
